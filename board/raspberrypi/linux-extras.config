# Optimisation de la taille (Point 7)
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# Protection de la pile et détection des débordements de tampon
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y

# Restrictions d'accès à /dev/mem et aux symboles du noyau (kallsyms / dmesg)
CONFIG_DEVMEM=n
CONFIG_SECURITY_DMESG_RESTRICT=y

# Durcissement de l'allocateur mémoire (SLAB/SLUB) et initialisation à zéro
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y

# Désactivation des fonctionnalités legacy risquées
CONFIG_LEGACY_PTYS=n
CONFIG_HIBERNATION=n
CONFIG_KEXEC=n
CONFIG_BINFMT_MISC=n

CONFIG_MODULES=n
