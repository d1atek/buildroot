image boot.vfat {
	vfat {
		files = {
#BOOT_FILES#
		"Image",
		"boot.scr",
		"uInitrd",
		}
	}

	size = 128M
}

image sdcard.img {
	hdimage {
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootfs {
		partition-type = 0x83
		image = "rootfs.ext4"
	}

	partition rootfs_luks {
		partition-type = 0x83
		image = "rootfs.luks"
	}
}
