CONFIG_BOOTDELAY=-1
CONFIG_CMD_PAUSE=y
CONFIG_CMD_BOOTMENU=y
CONFIG_FIT=y
CONFIG_FIT_SIGNATURE=y
CONFIG_FIT_CIPHER=y
CONFIG_FIT_VERBOSE=y
CONFIG_BOOTMENU_DISABLE_UBOOT_CONSOLE=n
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="setenv fit_addr_r 0x10000000; setenv bootmenu_0 'Boot Linux (FIT) + rootfs from SD card=fatload mmc 0:1 ${fit_addr_r} kernel.itb; bootm ${fit_addr_r} - ${fdt_addr}'"
CONFIG_STACKPROTECTOR=y
